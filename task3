#include <iostream>
#include <vector>
#include <map>
#include <queue>
#include <algorithm>
using namespace std;
struct Graph {
    map<char, vector<pair<char, int>>> adjList;
    void add_edge(char u, char v, int weight) {
        adjList[u].push_back({v, weight});
        adjList[v].push_back({u, weight});
    }
    void run_dijkstra(char start) {
        map<char, int> dist;
        map<char, char> parent;
        int INF = 2147483647;

        for (auto const& [node, _] : adjList) {
            dist[node] = INF;
            parent[node] = '\0';
        }
        priority_queue<pair<int, char>, vector<pair<int, char>>, greater<pair<int, char>>> pq;

        dist[start] = 0;
        pq.push({0, start});

        while (!pq.empty()) {
            char u = pq.top().second;
            int d = pq.top().first;
            pq.pop();

            if (d > dist[u]) continue;

            for (auto const& edge : adjList[u]) {
                char v = edge.first;
                int weight = edge.second;
                if (dist[u] + weight < dist[v]) {
                    dist[v] = dist[u] + weight;
                    parent[v] = u;
                    pq.push({dist[v], v});
                }
            }
        }

        cout << "--- TASK 3: DIJKSTRA (Source: " << start << ") ---" << endl;
        for (auto const& [node, d] : dist) {
            cout << "To " << node << " | Dist: " << d << " | Path: ";
            
            vector<char> path;
            for (char at = node; at != '\0'; at = parent[at]) path.push_back(at);
            reverse(path.begin(), path.end());
            
            for (int i = 0; i < path.size(); i++) {
                cout << path[i] << (i == path.size() - 1 ? "" : " -> ");
            }
            cout << endl;
        }
    }
};

int main() {
    Graph g;
    g.add_edge('B', 'A', 4); g.add_edge('C', 'A', 6);
    g.add_edge('D', 'B', 5); g.add_edge('E', 'B', 1);
    g.add_edge('F', 'D', 13); g.add_edge('G', 'E', 9);
    g.add_edge('F', 'A', 7);

    g.run_dijkstra('D');
    return 0;
}
